HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Optional for Indeed and ZipRecruiter indexed listings in the current app.
# Set this on the server only. Searches consume your provider quota.
# SERPAPI_API_KEY=your-key
# Settings below apply to the optional legacy local SQLite server.
REFRESH_HOURS=2
# Every refresh re-fetches all enabled sources and discovered company boards.
SCAN_CONCURRENCY=16
# Public search pages per query (1–10). Search covers the last 7 days.
SEARCH_PAGES=3
# JobSpy is the first collector for Indeed and ZipRecruiter on each refresh.
JOBSPY_ENABLED=1
JOBSPY_RESULTS=60
JOBSPY_COUNTRY=USA
JOBSPY_TIMEOUT_SECONDS=180
# Defaults to .tools/jobspy; override only to use another Python environment.
# JOBSPY_PYTHON=C:\path\to\python.exe
# Recent pages per Runway role type / Intern List engineering region (1–100).
AGGREGATOR_PAGES=10
# Workday pages per internship category/search (1–500, 20 listings per page).
WORKDAY_PAGES=100
# Persistent description backfill runs independently of listing refreshes.
ENRICH_BATCH_SIZE=36
ENRICH_INTERVAL_SECONDS=2
ENRICH_CONCURRENCY=6
# Optional Google Jobs index fallback when direct searches are restricted.
# Search preferences are sent to SerpApi; your resume is never sent.
# Set a secret only if an external scheduler will call POST /api/cron/refresh.
# CRON_SECRET=replace-with-a-long-random-secret
